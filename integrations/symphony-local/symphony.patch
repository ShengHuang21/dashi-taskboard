+  defp handle_request(conn, api, state_root) do
+    {:ok, body, conn} = Plug.Conn.read_body(conn)
+    payload = if body == "", do: nil, else: Jason.decode!(body)
+
+    action =
+      Agent.get_and_update(api, fn state ->
+        next = %{state | requests: state.requests ++ [{conn.method, conn.request_path, payload}]}
+        response(conn, payload, next, state_root)
+      end)
+
+    case action do
+      :lost -> Req.Test.transport_error(conn, :timeout)
+      {status, value} -> conn |> Plug.Conn.put_resp_content_type("application/json") |> Plug.Conn.send_resp(status, Jason.encode!(value))
+    end
+  end
+
+  defp response(conn, payload, state, state_root) do
+    cond do
+      String.ends_with?(conn.request_path, "/context") ->
+        {{200, %{"release" => state.release, "protection" => %{"inputRoot" => Path.dirname(state_root), "deniedPaths" => [state_root]}}}, state}
+
+      String.ends_with?(conn.request_path, "/finalize") ->
+        finalize_response(payload, state)
+
+      conn.method == "GET" ->
+        {{200, state.claim}, state}
+
+      state.deny ->
+        {{409, %{"error" => %{"code" => "CLAIM_DENIED"}}}, state}
+
+      true ->
+        claimed_response(state, state_root)
+    end
+  end
+
+  defp finalize_response(payload, state) do
+    kind = payload["kind"]
+
+    if state.offline or state.offline_kind == kind do
+      {{503, %{}}, state}
+    else
+      assert Map.get(state.accepted, kind, payload) == payload
+      next = %{state | accepted: Map.put(state.accepted, kind, payload)}
+
+      if state.lose_finalize == kind do
+        {:lost, %{next | lose_finalize: nil}}
+      else
+        {{200, %{"receipt" => kind}}, next}
+      end
+    end
+  end
+
+  defp claimed_response(state, state_root) do
+    if not state.claimed, do: assert(not File.exists?(Path.join(state_root, state.claim["attemptId"])))
+    response = if state.lose_claim, do: :lost, else: {200, state.claim}
+    {response, %{state | claimed: true}}
+  end
+
+  defp finalizations(api) do
+    Agent.get(api, fn state ->
+      for {"POST", path, body} <- state.requests, String.ends_with?(path, "/finalize"), do: body
+    end)
+  end
+
+  defp seed_pending(context) do
+    File.mkdir!(context.directory)
+    Agent.update(context.api, &%{&1 | claimed: true})
+
+    for {name, value} <- [
+          {"snapshot.json", %{"release" => context.release}},
+          {"claim.json", context.claim},
+          {"result.json", %{"status" => "failed", "turns" => 0}},
+          {"stop.json", %{"processTreeStopped" => true}}
+        ],
+        do: File.write!(Path.join(context.directory, name), Jason.encode!(value))
+  end
+
+  defp read(directory, name), do: directory |> Path.join(name) |> File.read!() |> Jason.decode!()
+end
