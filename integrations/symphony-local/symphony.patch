+defmodule SymphonyElixir.Local.Client do
+  @moduledoc "Project-scoped loopback transport for immutable releases and idempotent receipts."
+  alias SymphonyElixir.Config
+  alias SymphonyElixir.Local.Runner
+  alias SymphonyElixir.Tracker.Issue
+
+  @spec validate_settings(map()) :: :ok | {:error, term()}
+  def validate_settings(settings) do
+    p = settings.provider
+
+    with :ok <- validate_endpoint(p["url"]),
+         :ok <- validate_paths(p),
+         :ok <- require_text(p["project_id"], :missing_local_project),
+         :ok <- require_text(p["instance_id"], :missing_local_instance),
+         :ok <- validate_token_name(p["token_env"]) do
+      require_text(System.get_env(p["token_env"]), :missing_local_token)
+    end
+  end
+
+  defp validate_endpoint(value) when is_binary(value) do
+    case URI.parse(value) do
+      %URI{scheme: "http", host: "127.0.0.1", userinfo: nil, query: nil, fragment: nil, path: p, port: port}
+      when p in [nil, "", "/"] and is_integer(port) and port > 0 ->
+        :ok
+
+      _ ->
+        {:error, :invalid_local_endpoint}
+    end
+  end
+
+  defp validate_endpoint(_), do: {:error, :invalid_local_endpoint}
+
+  defp validate_paths(provider) do
+    if Enum.all?(["state_root", "supervisor", "python", "capability_file"], &absolute_path?(provider[&1])), do: :ok, else: {:error, :invalid_local_paths}
+  end
+
+  defp absolute_path?(value) when is_binary(value), do: Path.type(value) == :absolute
+  defp absolute_path?(_), do: false
+  defp require_text(value, _error) when is_binary(value) and value != "", do: :ok
+  defp require_text(_, error), do: {:error, error}
+
+  defp validate_token_name(name) when is_binary(name) do
+    if Regex.match?(~r/^[A-Z_][A-Z0-9_]*$/, name), do: :ok, else: {:error, :invalid_local_token_env}
+  end
+
