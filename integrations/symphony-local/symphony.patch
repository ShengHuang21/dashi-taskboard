+defmodule SymphonyElixir.Local.Adapter do
+  @moduledoc "Immutable Taskboard releases through the native scheduler, without issue-provider tools."
+  @behaviour SymphonyElixir.Tracker
+  alias SymphonyElixir.Local.Client
+
+  @impl true
+  def validate_config(settings) do
+    with :ok <- Client.validate_settings(settings),
+         true <- settings.active_states == ["ready", "running"],
+         true <- settings.terminal_states == ["in_review", "failed", "canceled", "superseded"] do
+      :ok
+    else
+      false -> {:error, :invalid_local_states}
+      error -> error
+    end
+  end
+
+  @impl true
+  def fetch_issues_by_states(states), do: Client.fetch("states", states)
+
+  @impl true
+  def fetch_issues_by_ids(ids), do: Client.fetch("ids", ids)
+
+  @impl true
+  def agent_tool_specs, do: []
+
+  @impl true
+  def secret_environment_names(settings) do
+    [settings.provider["token_env"], "CODEX_TASKBOARD_INSTANCE_SECRET", "CODEX_TASKBOARD_INSTANCE_TOKEN", "GITHUB_TOKEN", "GH_TOKEN", "LINEAR_API_KEY"] |> Enum.filter(&is_binary/1)
+  end
+end
