+"""Controlled stdio peer for same-BEAM Local.Runner lifecycle tests; no model calls."""
+import json
+import os
+import pathlib
+import sys
+import time
+
+action, name = sys.argv[1:]
+directory = pathlib.Path(name)
+
+
+def write(name, value):
+    (directory / name).write_text(json.dumps(value))
+
+
+if action == "observe-stopped":
+    stop = json.loads((directory / "stop.json").read_text())
+    if stop.get("unknown"):
+        sys.exit(2)
+    sys.stdout.write(json.dumps(stop))
+    sys.exit(0)
+
+snapshot = json.loads((directory / "snapshot.json").read_text())
+mode = snapshot["release"]["execution"]["objective"]
+write("launch-observed.json", {"pid": os.getpid(), "mode": mode})
+turns = 0
+trace = []
+
+
+def emit(value):
+    print(json.dumps(value), flush=True)
+
+
+try:
+    if mode == "fail_start":
+        sys.exit(1)
+    for line in sys.stdin:
+        message = json.loads(line)
+        trace.append(message)
+        write("protocol.json", trace)
+        method = message.get("method")
+        if method == "initialize":
+            emit({"id": message["id"], "result": {}})
+        elif method == "permissionProfile/list":
+            emit({"id": message["id"], "result": {"data": [{"id": "taskboard_local", "allowed": mode != "profile_missing"}]}})
+        elif method == "experimentalFeature/list":
+            names = "plugins remote_plugin apps browser_use browser_use_external in_app_browser computer_use hooks multi_agent skill_mcp_dependency_install image_generation view_image code_mode code_mode_host artifact in_app_chat in_app_local_automation memories skill_search worktrees workspace_dependencies realtime_conversation tool_suggest standalone_web_search daemon_auto_start goals shell_snapshot multi_agent_v2".split()
+            emit({"id": message["id"], "result": {"data": [{"name": name, "enabled": mode != "host_disabled" if name == "code_mode_host" else mode == "feature_enabled", "stage": "stable"} for name in names if mode != "host_missing" or name != "code_mode_host"]}})
+        elif method == "config/read":
+            emit({"id": message["id"], "result": {"config": {"web_search": "live" if mode == "web_enabled" else "disabled", "mcp_servers": {"fixture": {"enabled": mode == "mcp_config_enabled"}}}}})
+        elif method == "mcpServerStatus/list" and mode == "mcp_error":
+            emit({"id": message["id"], "error": {"message": "unsupported"}})
+        elif method == "mcpServerStatus/list":
