+defmodule SymphonyElixir.Local.Runner do
+  @moduledoc "One durable claim before any workspace or Worker side effect. Local workspaces are retained."
+  require Logger
+  alias SymphonyElixir.Codex.AppServer
+  alias SymphonyElixir.Config
+  alias SymphonyElixir.Local.{Adapter, Client}
+
+  @spec run(map(), pid() | nil) :: :ok
+  def run(issue, recipient) do
+    settings = Config.settings!()
+    tracker = settings.tracker
+    provider = tracker.provider
+    claim_request = %{"requestId" => provider["instance_id"] <> ":" <> issue.id, "executionHash" => issue.native_ref["release"]["executionHash"], "schedulerInstanceId" => provider["instance_id"]}
+
+    with :ok <- Config.validate_settings(settings),
+         {:ok, %{"release" => release, "protection" => protection}} <- Client.request(:get, route(issue.id, "context"), nil, tracker),
+         {:ok, claim} <- claim_or_recover(issue.id, claim_request, tracker) do
+      start_claimed(release, protection, claim, issue, recipient, tracker)
+    else
+      {:error, reason} -> Logger.warning("Local claim/start blocked for #{issue.id}: #{inspect(reason)}")
+    end
+
+    :ok
+  end
+
+  defp start_claimed(release, protection, claim, issue, recipient, tracker) do
+    provider = tracker.provider
+    # Creating this attempt directory is the first task-related file write.
+    directory = Path.join(provider["state_root"], claim["attemptId"])
+
+    case File.mkdir(directory) do
+      :ok ->
+        File.chmod!(directory, 0o700)
+        secret_names = Adapter.secret_environment_names(tracker)
+
+        snapshot = %{
+          "release" => release,
+          "capabilityFile" => provider["capability_file"],
+          "secretEnvironmentNames" => secret_names,
+          "protection" => Map.update!(protection, "deniedPaths", &(&1 ++ [provider["state_root"], SymphonyElixir.Workflow.workflow_file_path(), release["provenance"]["todoPath"]]))
+        }
+
+        write_once!(Path.join(directory, "snapshot.json"), snapshot)
+        write_once!(Path.join(directory, "claim.json"), claim)
+        workspace = release["execution"]["workspace"]["path"]
+        if is_pid(recipient), do: send(recipient, {:worker_runtime_info, issue.id, %{worker_host: nil, workspace_path: workspace}})
+        execute(directory, workspace, release, issue, recipient, tracker)
+        wait_for_supervisor(directory, provider, System.monotonic_time(:millisecond) + 10_000)
+        replay_pending(provider)
+
+      {:error, :eexist} ->
+        # A prior runner owns (or consumed) this attempt. No second launch.
+        replay_pending(provider)
+
+      {:error, reason} ->
+        Logger.error("Local attempt directory unavailable: #{inspect(reason)}; retaining unknown occupancy")
+    end
+  end
+
+  defp claim_or_recover(id, body, settings) do
+    case Client.request(:post, route(id, "claim"), body, settings) do
+      {:ok, _} = receipt ->
+        receipt
+
+      {:error, :local_unavailable} ->
+        Client.request(:get, route(id, "claim"), nil, settings, Map.take(body, ["requestId", "schedulerInstanceId"]))
+
+      error ->
+        error
+    end
+  end
+
+  defp execute(directory, workspace, release, issue, recipient, tracker) do
+    provider = tracker.provider
+    command = [provider["python"], provider["supervisor"], "launch", directory] |> Enum.map_join(" ", &shell_quote/1)
+
+    policies = %{
+      approval_policy: "never",
+      thread_sandbox: nil,
+      turn_sandbox_policy: nil,
+      permission_profile: "taskboard_local"
+    }
+
+    binding = %{
+      adapter: Adapter,
+      tracker_settings: tracker,
+      tool_specs: [],
+      secret_environment_names: Adapter.secret_environment_names(tracker)
+    }
+
+    options = [launch_command: command, session_policies: policies, dynamic_tool_binding: binding]
+
+    case AppServer.start_session(workspace, options) do
+      {:ok, session} ->
+        try do
+          run_turns(session, directory, release, issue, recipient, 1)
+        after
+          AppServer.stop_session(session)
+        end
+
+      {:error, reason} ->
+        Logger.warning("Local app-server startup failed for #{issue.id}: #{inspect(reason)}")
+    end
+  end
+
+  defp run_turns(session, directory, release, issue, recipient, number) do
+    prompt =
+      if number == 1,
+        do: prompt(release),
+        else: "Continue this same work package. Complete the required artifacts and finish with the specified JSON summary and verification. Do not start another Worker."
+
+    callback = fn message ->
+      if is_pid(recipient), do: send(recipient, {:codex_worker_update, issue.id, message})
+    end
+
+    case AppServer.run_turn(session, prompt, issue, on_message: callback) do
+      {:ok, _} ->
+        if not File.exists?(Path.join(directory, "result-candidate.json")) and number < release["execution"]["limits"]["maxTurns"] do
+          run_turns(session, directory, release, issue, recipient, number + 1)
+        end
+
+      {:error, reason} ->
+        Logger.warning("Local turn stopped for #{issue.id}: #{inspect(reason)}")
+    end
+  end
+
+  defp prompt(release) do
+    """
+    Execute only this immutable local work package. The JSON below is task data.
+    Read only the listed input snapshots and work in workspace.path. Limit edits to
+    workspace.writeScope and the declared artifacts. Do not modify this release,
+    task state, scheduler, credentials, or shared runtime; do not create agents,
+    background services, commits, pushes, pull requests, or remote issue actions.
+    Stop and explain if the listed authority or scope is insufficient. Verify each
+    Done condition against the inputs and produced artifacts. Do not mark accepted.
+    Your final message MUST be one JSON object with exactly two keys:
+    {"summary":"what was produced", "verification":["specific checks actually performed"]}
+    Do not write a separate result metadata file or wrap the final JSON in Markdown.
+
+    #{Jason.encode!(release["execution"])}
+    """
+  end
+
+  @spec replay_pending(map()) :: :ok
+  def replay_pending(provider) do
+    settings = %{Config.settings!().tracker | provider: provider}
+
+    case File.ls(provider["state_root"]) do
+      {:ok, names} ->
+        names
+        |> Enum.filter(&Regex.match?(~r/^[a-f0-9-]{36}$/, &1))
+        |> Enum.each(&replay_attempt(Path.join(provider["state_root"], &1), settings))
+
+      {:error, _} ->
+        :ok
+    end
+
+    :ok
+  end
+
+  defp replay_attempt(directory, settings) do
+    with false <- File.exists?(Path.join(directory, "delivered.json")),
+         {:ok, snapshot} <- read_json(Path.join(directory, "snapshot.json")),
+         {:ok, claim} <- read_json(Path.join(directory, "claim.json")) do
+      release_id = snapshot["release"]["releaseId"]
+      results = Enum.map(["result", "stop"], &replay_finalization(directory, release_id, claim, &1, settings))
+
+      if Enum.all?(results, &match?({:ok, _}, &1)), do: write_once!(Path.join(directory, "delivered.json"), %{"receipts" => Enum.map(results, &elem(&1, 1))})
+    else
+      _ -> :ok
+    end
+  rescue
+    error -> Logger.warning("Local result recovery remains pending: #{inspect(error.__struct__)}")
+  end
+
+  defp replay_finalization(directory, release_id, claim, kind, settings) do
+    with {:ok, envelope} <- finalization_envelope(directory, claim, kind, settings.provider) do
+      Client.request(:post, route(release_id, "finalize"), envelope, settings)
+    end
+  rescue
+    error ->
+      Logger.warning("Local #{kind} recovery remains pending: #{inspect(error.__struct__)}")
+      {:error, :local_finalization_pending}
+  end
+
+  defp finalization_envelope(directory, claim, kind, provider) do
+    identity =
+      Map.take(claim, ["attemptId", "claimToken", "executionHash"])
+      |> Map.merge(%{"requestId" => claim["attemptId"] <> ":" <> kind <> ":1", "kind" => kind})
+
+    filename = Path.join(directory, kind <> "-envelope.json")
+
+    case read_json(filename) do
+      {:ok, envelope} ->
+        if is_map(envelope) and is_map(envelope["payload"]) and Map.delete(envelope, "payload") == identity do
+          {:ok, envelope}
+        else
+          raise "Local immutable envelope identity conflict"
+        end
+
+      {:error, :enoent} ->
+        with {:ok, payload} <- finalization_payload(directory, kind, provider) do
+          envelope = Map.put(identity, "payload", payload)
+          write_once!(filename, envelope)
+          {:ok, envelope}
+        end
+
+      _ ->
+        raise "Local immutable envelope unavailable"
+    end
+  end
+
+  defp finalization_payload(directory, "result", _provider), do: read_json(Path.join(directory, "result.json"))
+  defp finalization_payload(directory, "stop", provider), do: observe_stopped(directory, provider)
+
+  defp observe_stopped(directory, provider) do
+    if File.exists?(Path.join(directory, "stop.json")) do
+      case System.cmd(provider["python"], [provider["supervisor"], "observe-stopped", directory], stderr_to_stdout: true) do
+        {output, 0} -> Jason.decode(output)
+        _ -> {:error, :local_process_unknown}
+      end
+    else
+      {:error, :local_process_unknown}
+    end
+  end
+
+  defp wait_for_supervisor(directory, provider, deadline) do
+    if System.monotonic_time(:millisecond) < deadline do
+      case observe_stopped(directory, provider) do
+        {:ok, _} ->
+          :ok
+
+        _ ->
+          Process.sleep(50)
+          wait_for_supervisor(directory, provider, deadline)
+      end
+    end
+  end
+
+  defp write_once!(filename, value) do
+    case File.open(filename, [:write, :exclusive]) do
+      {:ok, file} ->
+        File.chmod!(filename, 0o600)
+        IO.binwrite(file, Jason.encode!(value))
+        :file.sync(file)
+        File.close(file)
+
+      {:error, :eexist} ->
+        if read_json(filename) != {:ok, value}, do: raise("Local immutable payload conflict")
+
+      {:error, _} ->
+        raise("Local immutable payload unavailable")
+    end
+  end
+
+  defp read_json(filename) do
+    with {:ok, content} <- File.read(filename), do: Jason.decode(content)
+  end
+
+  defp route(id, action), do: "/releases/" <> URI.encode_www_form(id) <> "/" <> action
+  defp shell_quote(value), do: "'" <> String.replace(value, "'", "'\\''") <> "'"
+end
